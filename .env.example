# Frontend Environment Variables — Example
# Copy this file to .env.local for local dev or .env.production for production builds.

# Full URL of the deployed backend (AWS Lambda API Gateway or Function URL).
# No trailing slash. No /api/v1 suffix — the API client appends that automatically.
# Example: https://xxxxxx.execute-api.us-east-1.amazonaws.com/default/protfoolio-backend
VITE_API_BASE_URL=http://localhost:5001

# Optional: Override the LinkedIn profile photo URL
# Leave blank to use the backend-served /Linkdln_profilePhoto.jpg
VITE_LINKEDIN_AVATAR=

